#!/bin/bash
export HOME="/root"
export USER="root"
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

xsetroot -solid "#1e1e2e"

if which dbus-launch >/dev/null 2>&1; then
    eval $(dbus-launch --sh-syntax --exit-with-session)
fi

# Pre-configure XFCE panel default layout to prevent first-start dialog
if [ ! -d "/root/.config/xfce4" ]; then
    mkdir -p /root/.config/xfce4/xfconf/xfce-perchannel-xml
    cp -r /etc/xdg/xfce4/panel/default.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml 2>/dev/null || true
fi

exec startxfce4
